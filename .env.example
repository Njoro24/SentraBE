# Database
DATABASE_URL=postgresql://user:password@localhost:5432/sentra_db

# JWT
JWT_SECRET_KEY=your-secret-key-change-in-production

# API
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=False
ENVIRONMENT=production
SENTRA_API_URL=http://localhost:8000

# Docker PostgreSQL credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-secure-password
POSTGRES_DB=sentra_db

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_FRAUD_ALERTS=fraud-alerts
KAFKA_TOPIC_TRANSACTIONS=transactions
KAFKA_CONSUMER_GROUP=sentra-fraud-detection

# Neo4j Configuration
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-neo4j-password

# T24 Integration
T24_API_BASE_URL=http://localhost:8000/t24
T24_API_TIMEOUT=10

# Admin Setup
ADMIN_USERNAME=admin
ADMIN_EMAIL=your-admin-email@example.com
ADMIN_PASSWORD=your-secure-admin-password

# OTP Configuration
OTP_EXPIRATION_MINUTES=5

# Email Configuration (Resend)
RESEND_API_KEY=your-resend-api-key

# SMS Configuration (Africa's Talking)
AFRICASTALKING_USERNAME=your-africastalking-username
AFRICASTALKING_API_KEY=your-africastalking-api-key
AFRICASTALKING_SENDER_ID=SentraAlert

# Model Configuration
MODEL_PATH=models/xgboost_model.pkl
